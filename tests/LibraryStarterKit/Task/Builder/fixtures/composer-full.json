{
    "name": "ramsey/php-library-starter-kit",
    "type": "project",
    "description": "A starter kit for quickly setting up a new PHP library package.",
    "keywords": [
        "builder",
        "library",
        "package",
        "skeleton",
        "template"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ramsey/php-library-starter-kit/issues",
        "security": "https://github.com/ramsey/php-library-starter-kit/security/policy"
    },
    "require": {
        "php": "^8.5",
        "symfony/console": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/process": "^8.1",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "captainhook/plugin-composer": "^5.3",
        "ergebnis/composer-normalize": "^2.56",
        "fakerphp/faker": "^1.24",
        "hamcrest/hamcrest-php": "^3.0",
        "infection/infection": "^0.35",
        "mockery/mockery": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^12.5",
        "ramsey/coding-standard": "^2.4",
        "ramsey/composer-repl": "^1.5",
        "ramsey/conventional-commits": "^1.7",
        "roave/security-advisories": "dev-latest",
        "spatie/phpunit-snapshot-assertions": "^5.1"
    },
    "suggest": {
        "ext-foobar": "Foo bar"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "ramsey/conventional-commits": {
            "configFile": "conventional-commits.json"
        },
        "ramsey/devtools": {
            "command-prefix": "dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Ramsey\\Dev\\LibraryStarterKit\\": "src/LibraryStarterKit/",
            "Vendor\\SubNamespace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramsey\\Test\\Dev\\LibraryStarterKit\\": "tests/LibraryStarterKit/",
            "Vendor\\Test\\SubNamespace\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": "git init",
        "post-create-project-cmd": "Ramsey\\Dev\\LibraryStarterKit\\Wizard::start",
        "analyze": "vendor/bin/phpstan analyze --ansi -v --memory-limit=1G",
        "coverage": [
            "git clean -fx build/coverage/.",
            "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html build/coverage/coverage-html",
            "open build/coverage/coverage-html/index.html"
        ],
        "coverage-ci": "XDEBUG_MODE=coverage phpunit --colors=always --testdox --coverage-text --coverage-clover build/coverage/clover.xml",
        "fix": [
            "@composer normalize",
            "vendor/bin/phpcbf --cache=build/phpcs-cache"
        ],
        "lint": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "vendor/bin/phpcs --colors --cache=build/phpcs-cache",
            "@analyze"
        ],
        "mutation": "XDEBUG_MODE=coverage vendor/bin/infection --show-mutations=0",
        "starter-kit": "Ramsey\\Dev\\LibraryStarterKit\\Wizard::start",
        "test": "vendor/bin/phpunit --colors=always"
    },
    "scripts-descriptions": {
        "analyze": "Runs static analysis.",
        "coverage": "Runs unit tests with code coverage analysis and opens the coverage report in a web browser.",
        "coverage-ci": "Runs unit tests with code coverage analysis and outputs a Clover XML file.",
        "fix": "Fixes coding standards violations and normalizes composer.json.",
        "lint": "Runs coding standards checks and static analysis.",
        "mutation": "Runs mutation testing.",
        "starter-kit": "Runs the PHP Library Starter Kit wizard.",
        "test": "Runs unit tests."
    }
}
